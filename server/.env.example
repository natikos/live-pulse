# Copy to .env (in server/) and adjust. Defaults match the docker-compose.yml services.

# HTTP
PORT=3000

# Postgres
DATABASE_URL=postgresql://livepulse:livepulse@localhost:5432/livepulse

# Redis (cache + pub/sub)
REDIS_URL=redis://localhost:6379

# Kafka (host listener)
KAFKA_BROKERS=localhost:9092

# RabbitMQ (profile: rabbit)
RABBITMQ_URL=amqp://livepulse:livepulse@localhost:5672

# Events: how far ahead of the server clock occurred_at may be (ms, default 300000)
MAX_CLOCK_SKEW_MS=300000
# Events: how old occurred_at may be (ms, default 2592000000 = 30 days)
MAX_EVENT_AGE_MS=2592000000

# Observability (profile: tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
