                            "maxLength": 128
                          },
                          "entity_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "referrer": {
                            "type": "string",
                            "maxLength": 2048
                          },
                          "utm_source": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "utm_medium": {
                            "type": "string",
                            "maxLength": 128
