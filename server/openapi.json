    "/events": {
      "get": {
        "description": "Filters are optional and combined with AND. `type` may be repeated (`?type=error&type=purchase`). `startDate` and `endDate` are Unix time in milliseconds, inclusive; `startDate` must not be later than `endDate`. Events are returned newest first by `occurred_at`; `limit` caps how many (1-100, default 50). Unknown query keys are rejected.",
        "operationId": "EventsController_listEvents",
        "parameters": [
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "page_view",
                  "purchase",
                  "error"
                ]
              }
            }
          },
          {
            "name": "startDate",
            "required": false,
            "in": "query",
            "description": "Unix time in milliseconds, inclusive.",
            "schema": {
              "description": "Unix time in milliseconds, inclusive.",
              "type": "integer",
              "minimum": 1000000000000,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "endDate",
            "required": false,
            "in": "query",
            "description": "Unix time in milliseconds, inclusive.",
            "schema": {
              "description": "Unix time in milliseconds, inclusive.",
              "type": "integer",
              "minimum": 1000000000000,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "base64url",
              "contentEncoding": "base64url",
              "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching events.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StoredEvent"
                      },
                      "description": "Newest first by `occurred_at`, at most `limit` items."
                    },
                    "nextCursor": {
                      "nullable": true,
                      "description": "Opaque. Pass as `cursor` to get the next page; `null` when there are no more events.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The query is invalid. `message` lists each problem as \"field: reason\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestError"
                }
              }
            }
          }
        },
        "summary": "List events",
        "tags": [
          "Events"
        ]
      },
      "post": {
        "description": "Idempotent by `event_id`: the first event wins, a repeat is not stored again. `device_id` is required for `web` and `mobile` events. `purchase` is accepted from `server` only. Unknown keys are rejected.",
