# Copy to .env and adjust if ports clash. All values have working defaults in docker-compose.yml.

# Postgres
POSTGRES_USER=livepulse
POSTGRES_PASSWORD=livepulse
POSTGRES_DB=livepulse
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka (host listener; containers use kafka:29092)
KAFKA_PORT=9092

# RabbitMQ (profile: rabbit)
RABBITMQ_USER=livepulse
RABBITMQ_PASSWORD=livepulse
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
JAEGER_UI_PORT=16686

# Application connection strings (used by the NestJS apps from Stage 1)
DATABASE_URL=postgresql://livepulse:livepulse@localhost:5432/livepulse
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://livepulse:livepulse@localhost:5672
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
